# Fastfile
# FLO - Finance Ledger Optimizer
#
# Version 1.2 - Updated for Xcode 26 simulators
# Copyright © 2026 Finch & Poppy Co LLC. All rights reserved.
#
# USAGE:
# - Screenshots: fastlane screenshots
# - Quick test:  fastlane screenshots_quick
# - Beta deploy: fastlane beta
# - App Store:   fastlane release
#

default_platform(:ios)

platform :ios do
  
  # ============================================================================
  # SCREENSHOTS
  # ============================================================================
  
  desc "Capture screenshots for App Store"
  lane :screenshots do
    capture_screenshots(
      project: "FLO.xcodeproj",
      scheme: "FLO",
      devices: [
        "iPhone 16 Pro Max",
        "iPhone 16 Pro",
        "iPhone 16e",
      ],
      languages: ["en-US"],
      output_directory: "./fastlane/screenshots",
      clear_previous_screenshots: true,
      override_status_bar: true,
      localize_simulator: true,
      dark_mode: false,
      skip_open_summary: false
    )
  end
  
  desc "Capture screenshots for all device sizes"
  lane :screenshots_all do
    capture_screenshots(
      project: "FLO.xcodeproj",
      scheme: "FLO",
      devices: [
        "iPhone 16 Pro Max",
        "iPhone 16 Pro",
        "iPhone 16 Plus",
        "iPhone 16",
        "iPhone 16e",
        "iPad Pro 13-inch (M4)",
        "iPad Pro 11-inch (M4)",
        "iPad Air 13-inch (M3)",
      ],
      languages: ["en-US"],
      output_directory: "./fastlane/screenshots",
      clear_previous_screenshots: true,
      override_status_bar: true
    )
  end
  
  desc "Quick screenshot test (single device)"
  lane :screenshots_quick do
    capture_screenshots(
      project: "FLO.xcodeproj",
      scheme: "FLO",
      devices: ["iPhone 16 Pro"],
      languages: ["en-US"],
      output_directory: "./fastlane/screenshots/quick",
      clear_previous_screenshots: true
    )
  end
  
  # ============================================================================
  # TESTING
  # ============================================================================
  
  desc "Run all unit tests"
  lane :test do
    run_tests(
      project: "FLO.xcodeproj",
      scheme: "FLO",
      devices: ["iPhone 16 Pro"],
      code_coverage: true,
      output_directory: "./fastlane/test_results",
      output_types: "html,junit"
    )
  end
  
  desc "Run UI tests only"
  lane :test_ui do
    run_tests(
      project: "FLO.xcodeproj",
      scheme: "FLO",
      devices: ["iPhone 16 Pro"],
      only_testing: ["FLOUITests"],
      output_directory: "./fastlane/test_results"
    )
  end
  
  # ============================================================================
  # BETA DEPLOYMENT (TestFlight)
  # ============================================================================
  
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # NOTE: no increment_build_number here — it shells out to agvtool, which
    # picks an arbitrary base among this project's mixed target versions and
    # stamps LITERAL numbers into every Info.plist, breaking the
    # $(CURRENT_PROJECT_VERSION) convention (it rewrote 12 → 2 on 2026-07-24).
    # Build numbers are managed in the project; bump with:
    #   fastlane bump_build number:13
    build_app(
      project: "FLO.xcodeproj",
      scheme: "FLO",
      export_method: "app-store",
      output_directory: "./fastlane/builds",
      output_name: "FLO.ipa"
    )
    
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end
  
  # ============================================================================
  # APP STORE RELEASE
  # ============================================================================
  
  desc "Deploy a new version to the App Store"
  lane :release do
    capture_screenshots
    
    build_app(
      project: "FLO.xcodeproj",
      scheme: "FLO",
      export_method: "app-store"
    )
    
    upload_to_app_store(
      skip_screenshots: false,
      skip_metadata: false,
      submit_for_review: false,
      automatic_release: false,
      force: true
    )
  end
  
  # ============================================================================
  # UTILITY LANES
  # ============================================================================
  
  desc "Increment version number"
  lane :bump_version do |options|
    increment_version_number(
      xcodeproj: "FLO.xcodeproj",
      bump_type: options[:type] || "patch"
    )
  end
  
  desc "Set the build number on the shipping targets (app, widget, clip)"
  desc "Usage: fastlane bump_build number:13"
  lane :bump_build do |options|
    number = options[:number] || UI.user_error!("Usage: fastlane bump_build number:13")

    # Deliberately NOT increment_build_number/agvtool: it stamps literal
    # values into every Info.plist and clobbers the other targets'
    # independent versions (it rewrote 12 → 2 everywhere on 2026-07-24).
    # Also deliberately not Xcodeproj#save, which reserializes the whole
    # project file with unrelated churn. This edits exactly the six
    # CURRENT_PROJECT_VERSION lines of the shipping targets' build configs,
    # preserving the $(CURRENT_PROJECT_VERSION) plist convention.
    #
    # Build-config IDs (stable unless a target is deleted and recreated):
    #   FLO                Debug/Release: 433FDBF1…, 433FDBF2…
    #   FLOWidgetExtension Debug/Release: 436A0AB5…, 436A0AB6…
    #   FLOInvoiceClip     Debug/Release: 43F478C1…, 43F478C2…
    config_ids = %w[
      433FDBF12EB992B10008DA09 433FDBF22EB992B10008DA09
      436A0AB52EC02F930011973D 436A0AB62EC02F930011973D
      43F478C12F5CE2920098DC37 43F478C22F5CE2920098DC37
    ]

    path = File.expand_path("../FLO.xcodeproj/project.pbxproj", __dir__)
    content = File.read(path)
    updated = 0
    config_ids.each do |cid|
      updated += 1 if content.sub!(
        /(#{cid} \/\* (?:Debug|Release) \*\/ = \{[^\}]*?CURRENT_PROJECT_VERSION = )[^;]+(;)/m,
        "\\1#{number}\\2"
      )
    end
    UI.user_error!("Expected to update 6 configs, matched #{updated} — project structure changed?") unless updated == 6
    File.write(path, content)
    UI.success("CURRENT_PROJECT_VERSION = #{number} on FLO, FLOWidgetExtension, FLOInvoiceClip")
  end
  
  desc "Sync certificates and provisioning profiles"
  lane :sync_certs do
    match(
      type: "appstore",
      readonly: true
    )
  end
  
  # ============================================================================
  # ERROR HANDLING
  # ============================================================================
  
  error do |lane, exception|
    # Notification on failure (optional)
  end
  
end
